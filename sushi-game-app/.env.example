# Copia in .env (non versionato) per lo sviluppo locale.
# URL del backend: di default l'app usa https://sushi.dietalab.net
# Per un backend locale usa l'IP del PC raggiungibile dal telefono:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Dominio pubblico usato nei link di invito e per l'informativa privacy
# EXPO_PUBLIC_PUBLIC_URL=https://sushi.dietalab.net

# Ambiente: development | preview | production (di default production)
# APP_VARIANT=development
